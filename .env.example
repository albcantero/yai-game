# --- Supabase ---
# El cliente (navegador) ya tiene valores por defecto en src/lib/config.ts; esto es opcional para el cliente.
PUBLIC_SUPABASE_URL=https://uydwufnirtivbsckiisx.supabase.co

# SERVICE_ROLE: clave TODOPODEROSA (se salta la RLS). SOLO local, NUNCA commitear ni exponer en el cliente.
# Se usa únicamente en scripts de tooling (p. ej. `npm run reset`).
# Dónde sacarla: Supabase -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE=pega-aqui-tu-service-role-key
