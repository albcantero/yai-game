---
import "../styles/home.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Librería Santas Ochova." />
    <title>Santas Ochova</title>
  </head>
  <body>
    <main class="home">
      <img class="home__bg" src="/title-background.svg" alt="" />
      <div class="home__content">
        <h1 class="home__title"><span class="line">EL libro</span><span class="line line--wavy">PERDIDO</span></h1>
        <nav class="home__menu">
          <a class="pixel-btn" href="/fases">Fases</a>
          <a class="pixel-btn" href="/tienda">Tienda</a>
          <a class="pixel-btn" href="/terminal">Terminal</a>
          <button class="pixel-btn" type="button" disabled>Final</button>
        </nav>
      </div>
      <button class="home__sound" id="sound" type="button" aria-label="Sonido">🔊</button>
    </main>

    <script>
      import { animate, stagger } from "motion";

      // "EL libro" fijo; solo "perdido" se parte y ondula, caracter a caracter (Motion).
      (() => {
        const lines = document.querySelectorAll(".home__title .line--wavy");
        const chars = [];
        lines.forEach((line) => {
          const text = line.textContent || "";
          line.setAttribute("aria-label", text); // el lector lee "perdido", no "p-e-r-d-i-d-o"
          line.textContent = "";
          for (const c of text) {
            const s = document.createElement("span");
            s.className = "ch";
            s.setAttribute("aria-hidden", "true");
            s.textContent = c === " " ? " " : c;
            line.appendChild(s);
            chars.push(s);
          }
        });
        if (chars.length) {
          animate(
            chars,
            { y: [0, -52, 0] },
            { duration: 2.6, delay: stagger(0.08), repeat: Infinity, ease: "easeInOut" },
          );
        }
      })();

      // Loop sin corte con Web Audio API (AudioBufferSourceNode.loop = sample-accurate,
      // sin el hueco que deja <audio loop>).
      const soundBtn = document.getElementById("sound");
      const SRC = "/audio/pop-melodic-98.mp3";
      const AC = window.AudioContext || window.webkitAudioContext;
      let ctx, gain, buffer, source, loading, on = true;

      async function ensureBuffer() {
        if (buffer || !AC) return;
        if (!ctx) { ctx = new AC(); gain = ctx.createGain(); gain.connect(ctx.destination); }
        if (!loading) {
          loading = fetch(SRC).then((r) => r.arrayBuffer()).then((a) => ctx.decodeAudioData(a)).then((b) => { buffer = b; });
        }
        await loading;
      }
      async function play() {
        if (!on) return;
        await ensureBuffer();
        if (!buffer || source) return;
        if (ctx.state === "suspended") await ctx.resume();
        source = ctx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;
        source.connect(gain);
        source.start(0);
      }

      // Política de autoplay: arranca en la primera interacción.
      const kick = () => {
        play();
        window.removeEventListener("pointerdown", kick);
        window.removeEventListener("keydown", kick);
      };
      window.addEventListener("pointerdown", kick);
      window.addEventListener("keydown", kick);

      soundBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        on = !on;
        if (gain) gain.gain.value = on ? 1 : 0;
        soundBtn.textContent = on ? "🔊" : "🔇";
        if (on) play();
      });
    </script>
  </body>
</html>
