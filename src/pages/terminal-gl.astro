---
import "../styles/crt.css";
import TerminalGL from "../components/TerminalGL.tsx";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Terminal Santas Ochova · render CRT en WebGL (experimental)." />
    <title>Santas Ochova · CRT WebGL</title>
    <style is:global>
      html,
      body {
        height: 100%;
        margin: 0;
        background: #05070a;
      }
      .gl-stage {
        height: 100vh;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: env(safe-area-inset-top, 0px) 10px calc(env(safe-area-inset-bottom, 0px) + 10px);
        background: radial-gradient(120% 120% at 50% 0%, #14141a, #0a0a0d 60%, #050506);
      }
      .gl-screen {
        flex: 1;
        min-height: 0;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.72);
      }
      .gl-canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      .gl-shaderbtn {
        font: 10px "Courier New", monospace;
        color: #cfe;
        background: #2a2e28;
        border: 1px solid #4a4e45;
        border-radius: 4px;
        padding: 4px 8px;
        cursor: pointer;
      }
      .gl-shaderbtn:active {
        transform: translateY(1px);
      }
    </style>
  </head>
  <body>
    <main>
      <TerminalGL client:load />
    </main>
  </body>
</html>
